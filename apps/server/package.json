{
  "name": "@flai/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "migrate:legacy": "tsx --env-file-if-exists=../../.env scripts/migrate-from-flai.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.107",
    "@ai-sdk/openai": "^4.0.104",
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@flai/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@mastra/ai-sdk": "^1.11.2",
    "@mastra/core": "^1.80.0",
    "@modelcontextprotocol/client": "2.4.0",
    "ai": "^7.0.156",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  }
}

DATABASE_URL=postgres://flai:flai@127.0.0.1:55432/flai
# At least 32 characters. Use the SAME value as the old Go deployment only if you want old tokens to stay valid (not required).
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=168h
# S3 compatible storage (e.g. Cloudflare R2). Keep the old bucket so migrated file URLs keep working.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_URL=
# Optional Redis/Valkey (e.g. redis://127.0.0.1:56379 from compose.yaml). Enables resumable replies across
# restarts and stopping a reply from any instance. Without it replies are tracked in this process only.
REDIS_URL=
# Only used by scripts/migrate-from-flai.ts
LEGACY_DATABASE_URL=
